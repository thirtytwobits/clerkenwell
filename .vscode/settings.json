{
    // Use a separate target directory for rust-analyzer to avoid blocking the editor with CLI cargo runs.
    // `cargo check` artifacts under `target/rust-analyzer`.
    "rust-analyzer.cargo.targetDir": true,
    "cSpell.language": "en-GB",
    "cSpell.words": [
        "clerkenwell",
        "codegen"
    ],
    "cSpell.allowCompoundWords": true,
    "cSpell.caseSensitive": false,
    "cSpell.customDictionaries": {
        "london-project-words": {
            "name": "london-project-words",
            "path": "${workspaceFolder}/.vscode/london.dictionary.txt",
            "description": "Words used across all Project London projects.",
            "addWords": true
        }
    }
}