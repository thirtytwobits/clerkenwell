{
  "collaboration": {
    "entities": [
      {
        "authoringState": {
          "importMutation": "note.importUpdate",
          "projection": "notes.authoringState"
        },
        "fields": [
          {
            "conflict": "merge",
            "path": "body",
            "required": true,
            "storage": {
              "container": "body",
              "kind": "text"
            },
            "value": {
              "codec": "string"
            }
          },
          {
            "conflict": "immutable",
            "path": "etag",
            "required": true,
            "storage": {
              "kind": "derivedRevision"
            },
            "value": {
              "codec": "string"
            }
          },
          {
            "conflict": "immutable",
            "path": "note_id",
            "required": true,
            "storage": {
              "kind": "derivedIdentity"
            },
            "value": {
              "codec": "identity"
            }
          },
          {
            "conflict": "explicit",
            "path": "status",
            "required": true,
            "storage": {
              "container": "note",
              "key": "status",
              "kind": "scalar"
            },
            "value": {
              "codec": "string"
            },
            "writers": {
              "agent": "immutable"
            }
          },
          {
            "conflict": "lastWriterWins",
            "path": "title",
            "required": true,
            "storage": {
              "container": "note",
              "key": "title",
              "kind": "scalar"
            },
            "value": {
              "codec": "string"
            }
          }
        ],
        "name": "Note",
        "rootContainer": "note",
        "schemaVersion": 1
      }
    ],
    "version": 1
  },
  "commands": [],
  "definitions": [
    {
      "additionalProperties": false,
      "description": "A block of peers allocated to the subscriber: every peer whose bits above the low index_bits are base's. An import names the block by its nonce.",
      "name": "AuthoringPeerBlock",
      "properties": {
        "base": {
          "description": "The block's first peer, in decimal.",
          "type": "string"
        },
        "index_bits": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "nonce": {
          "type": "string"
        }
      },
      "required": [
        "nonce",
        "base",
        "index_bits"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "name": "AuthoringState",
      "properties": {
        "accepted_frontier_base64": {
          "description": "The frontier of the accepted state this delivery leaves its client holding.",
          "type": "string"
        },
        "etag": {
          "description": "The accepted state's etag.",
          "type": "string"
        },
        "exchange_modes": {
          "description": "How the store accepts an import of this document.",
          "items": {
            "$ref": "#/$defs/CollaborationExchangeMode"
          },
          "type": "array"
        },
        "peer_block": {
          "$ref": "#/$defs/AuthoringPeerBlock"
        },
        "replaces_held": {
          "description": "Whether the client replaces what it holds with this delivery, because what it named holding is not of this document's history.",
          "type": "boolean"
        },
        "schema_version": {
          "description": "The layout version the document's operations are written in.",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "update_base64": {
          "description": "The accepted operations this delivery adds: every one in a snapshot, and in a patch those after the frontier its client held.",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "accepted_frontier_base64",
        "update_base64",
        "etag",
        "exchange_modes",
        "peer_block",
        "replaces_held"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "name": "AuthoringStatePatch",
      "properties": {
        "kind": {
          "enum": [
            "replace",
            "remove"
          ],
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AuthoringState"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "description": "Whether an import creates a document (bootstrap) or edits one (incremental).",
      "enum": [
        "incremental",
        "bootstrap"
      ],
      "name": "CollaborationExchangeMode",
      "type": "string"
    },
    {
      "additionalProperties": false,
      "name": "NoteAuthoringParams",
      "properties": {
        "note_id": {
          "type": "string"
        }
      },
      "required": [
        "note_id"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "name": "NoteCreateParams",
      "properties": {
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "name": "NoteDocument",
      "properties": {
        "body": {
          "type": "string"
        },
        "etag": {
          "type": "string"
        },
        "note_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "review",
            "published"
          ],
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "etag",
        "title",
        "body",
        "status"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "name": "NoteMutationResult",
      "properties": {
        "etag": {
          "type": "string"
        },
        "note_id": {
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "etag"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "name": "ReplicaUpdateParams",
      "properties": {
        "base_frontier_base64": {
          "type": "string"
        },
        "exchange_mode": {
          "$ref": "#/$defs/CollaborationExchangeMode"
        },
        "intent": {
          "description": "Why the writer made the change.",
          "type": "string"
        },
        "note_id": {
          "type": "string"
        },
        "operation_id": {
          "minLength": 1,
          "type": "string"
        },
        "peer_nonces": {
          "description": "The nonce of every peer block the update's operations are written under.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "update_base64": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "operation_id",
        "exchange_mode",
        "update_base64",
        "peer_nonces"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "name": "ReplicaUpdateResult",
      "properties": {
        "accepted_frontier_base64": {
          "type": "string"
        },
        "etag": {
          "type": "string"
        },
        "missing_update_base64": {
          "type": "string"
        },
        "note_id": {
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "etag",
        "accepted_frontier_base64",
        "missing_update_base64"
      ],
      "type": "object"
    }
  ],
  "entities": [
    {
      "authoring": {
        "kind": "collaborative",
        "planningMutations": []
      },
      "id": "note_id",
      "name": "Note",
      "revision": {
        "kind": "replica"
      },
      "schema": {
        "$ref": "#/$defs/NoteDocument"
      }
    }
  ],
  "mutations": [
    {
      "description": "Creates a note with a title, and returns its id and etag.",
      "name": "note.create",
      "params": {
        "$ref": "#/$defs/NoteCreateParams"
      },
      "result": {
        "$ref": "#/$defs/NoteMutationResult"
      },
      "touches": [
        "Note"
      ]
    },
    {
      "description": "Imports operations a replica of a note wrote, under the peers allocated to its writer.",
      "name": "note.importUpdate",
      "params": {
        "$ref": "#/$defs/ReplicaUpdateParams"
      },
      "result": {
        "$ref": "#/$defs/ReplicaUpdateResult"
      },
      "touches": [
        "Note"
      ]
    }
  ],
  "namespace": "notes",
  "projections": [
    {
      "dependsOn": [
        "Note"
      ],
      "description": "The accepted state of one Note document, for keeping a replica of it.",
      "materialization": {
        "removeMode": "nullSnapshot",
        "snapshotField": "state",
        "snapshotMode": "field",
        "strategy": "replaceOrRemove"
      },
      "name": "notes.authoringState",
      "params": {
        "$ref": "#/$defs/NoteAuthoringParams"
      },
      "patch": {
        "$ref": "#/$defs/AuthoringStatePatch"
      },
      "snapshot": {
        "$ref": "#/$defs/AuthoringState"
      }
    }
  ],
  "version": 1
}
