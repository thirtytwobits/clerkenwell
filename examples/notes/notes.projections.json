{
  "version": 1,
  "namespace": "notes",
  "entities": {
    "Note": {
      "id": "note_id",
      "schema": {
        "$ref": "#/$defs/NoteDocument"
      },
      "revision": {
        "kind": "replica"
      },
      "authoring": {
        "kind": "collaborative",
        "planningMutations": []
      }
    }
  },
  "projections": {},
  "mutations": {
    "note.create": {
      "params": {
        "$ref": "#/$defs/NoteCreateParams"
      },
      "result": {
        "$ref": "#/$defs/NoteMutationResult"
      },
      "touches": [
        "Note"
      ]
    },
    "note.importUpdate": {
      "params": {
        "$ref": "#/$defs/ReplicaUpdateParams"
      },
      "result": {
        "$ref": "#/$defs/ReplicaUpdateResult"
      },
      "touches": [
        "Note"
      ]
    }
  },
  "collaboration": {
    "version": 1,
    "entities": {
      "Note": {
        "schemaVersion": 1,
        "authoringState": {
          "projection": "notes.authoringState",
          "importMutation": "note.importUpdate"
        },
        "rootContainer": "note",
        "fields": {
          "note_id": {
            "storage": {
              "kind": "derivedIdentity"
            },
            "value": {
              "codec": "identity"
            },
            "required": true,
            "conflict": "immutable"
          },
          "etag": {
            "storage": {
              "kind": "derivedRevision"
            },
            "value": {
              "codec": "string"
            },
            "required": true,
            "conflict": "immutable"
          },
          "title": {
            "storage": {
              "kind": "scalar",
              "container": "note",
              "key": "title"
            },
            "value": {
              "codec": "string"
            },
            "required": true,
            "conflict": "lastWriterWins"
          },
          "body": {
            "storage": {
              "kind": "text",
              "container": "body"
            },
            "value": {
              "codec": "string"
            },
            "required": true,
            "conflict": "merge"
          },
          "status": {
            "storage": {
              "kind": "scalar",
              "container": "note",
              "key": "status"
            },
            "value": {
              "codec": "string"
            },
            "required": true,
            "conflict": "explicit",
            "writers": {
              "agent": "immutable"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "NoteDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note_id",
        "etag",
        "title",
        "body",
        "status"
      ],
      "properties": {
        "note_id": {
          "type": "string"
        },
        "etag": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "published"
          ]
        }
      }
    },
    "NoteCreateParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "NoteMutationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note_id",
        "etag"
      ],
      "properties": {
        "note_id": {
          "type": "string"
        },
        "etag": {
          "type": "string"
        }
      }
    },
    "ReplicaUpdateParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note_id",
        "operation_id",
        "exchange_mode",
        "update_base64",
        "peer_nonces"
      ],
      "properties": {
        "note_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "exchange_mode": {
          "type": "string",
          "enum": [
            "incremental",
            "bootstrap"
          ]
        },
        "base_frontier_base64": {
          "type": "string"
        },
        "update_base64": {
          "type": "string",
          "minLength": 1
        },
        "peer_nonces": {
          "type": "array",
          "description": "The nonce of every peer block the update's operations are written under.",
          "items": {
            "type": "string"
          }
        },
        "intent": {
          "type": "string",
          "description": "Why the writer made the change."
        }
      }
    },
    "ReplicaUpdateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note_id",
        "etag",
        "accepted_frontier_base64",
        "missing_update_base64"
      ],
      "properties": {
        "note_id": {
          "type": "string"
        },
        "etag": {
          "type": "string"
        },
        "accepted_frontier_base64": {
          "type": "string"
        },
        "missing_update_base64": {
          "type": "string"
        }
      }
    }
  }
}
