{
  "version": 1,
  "compatibility": {
    "minimumReaderVersion": 1,
    "minimumWriterVersion": 1,
    "migrationIds": []
  },
  "namespace": "notes",
  "entities": {
    "Note": {
      "id": "note_id",
      "schema": {
        "$ref": "#/$defs/NoteDocument"
      },
      "revision": {
        "kind": "loro"
      },
      "authoring": {
        "kind": "collaborative",
        "rationale": "Writers edit a note concurrently: its body merges, and a change of status is decided explicitly.",
        "contentMutation": "note.importLoroUpdate",
        "planningMutations": [],
        "commandMutations": [],
        "lifecycleMutations": [
          "note.create"
        ]
      }
    }
  },
  "projections": {},
  "mutations": {
    "note.create": {
      "params": {
        "$ref": "#/$defs/NoteCreateParams"
      },
      "result": {
        "$ref": "#/$defs/NoteMutationResult"
      },
      "touches": [
        "Note"
      ]
    },
    "note.importLoroUpdate": {
      "params": {
        "$ref": "#/$defs/LoroUpdateParams"
      },
      "result": {
        "$ref": "#/$defs/LoroUpdateResult"
      },
      "touches": [
        "Note"
      ]
    }
  },
  "mnemonic": {
    "session.drafts": {
      "key": "notes.session.drafts",
      "version": 1,
      "schema": {
        "$ref": "#/$defs/SessionDrafts"
      },
      "cachePolicy": "localDraft",
      "migrationIds": [
        "session-drafts-v1"
      ],
      "recovery": "authoringRuntime"
    }
  },
  "collaboration": {
    "version": 1,
    "compatibility": {
      "minimumReaderVersion": 1,
      "minimumWriterVersion": 1,
      "migrationIds": []
    },
    "entities": {
      "Note": {
        "schemaVersion": 1,
        "migrationIds": [
          "note-loro-layout-v1"
        ],
        "authoringState": {
          "projection": "notes.authoringState",
          "importMutation": "note.importLoroUpdate"
        },
        "rootContainer": "note",
        "fields": {
          "note_id": {
            "storage": {
              "kind": "derivedIdentity"
            },
            "value": {
              "codec": "identity"
            },
            "required": true,
            "conflict": "immutable"
          },
          "etag": {
            "storage": {
              "kind": "derivedRevision"
            },
            "value": {
              "codec": "string"
            },
            "required": true,
            "conflict": "immutable"
          },
          "title": {
            "storage": {
              "kind": "scalar",
              "container": "note",
              "key": "title"
            },
            "value": {
              "codec": "string"
            },
            "required": true,
            "conflict": "lastWriterWins"
          },
          "body": {
            "storage": {
              "kind": "text",
              "container": "body"
            },
            "value": {
              "codec": "string"
            },
            "required": true,
            "conflict": "merge"
          },
          "status": {
            "storage": {
              "kind": "scalar",
              "container": "note",
              "key": "status"
            },
            "value": {
              "codec": "string"
            },
            "required": true,
            "conflict": "explicit"
          }
        }
      }
    }
  },
  "$defs": {
    "NoteDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note_id",
        "etag",
        "title",
        "body",
        "status"
      ],
      "properties": {
        "note_id": {
          "type": "string"
        },
        "etag": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "published"
          ]
        }
      }
    },
    "NoteCreateParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "NoteMutationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note_id",
        "etag"
      ],
      "properties": {
        "note_id": {
          "type": "string"
        },
        "etag": {
          "type": "string"
        }
      }
    },
    "LoroUpdateParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note_id",
        "operation_id",
        "exchange_mode",
        "update_base64"
      ],
      "properties": {
        "note_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "exchange_mode": {
          "type": "string",
          "enum": [
            "incremental",
            "bootstrap"
          ]
        },
        "base_frontier_base64": {
          "type": "string"
        },
        "update_base64": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SessionDrafts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drafts"
      ],
      "properties": {
        "drafts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DraftEntry"
          }
        }
      }
    },
    "DraftEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "entity_id",
        "saved_at",
        "payload"
      ],
      "properties": {
        "entity": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "saved_at": {
          "type": "string"
        },
        "payload": {
          "type": "json",
          "opaqueReason": "The unsent edit, in the entity's shape."
        }
      }
    },
    "LoroUpdateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note_id",
        "etag",
        "accepted_frontier_base64",
        "missing_update_base64"
      ],
      "properties": {
        "note_id": {
          "type": "string"
        },
        "etag": {
          "type": "string"
        },
        "accepted_frontier_base64": {
          "type": "string"
        },
        "missing_update_base64": {
          "type": "string"
        }
      }
    }
  }
}
