{
  "name": "@clerkenwell/react",
  "version": "0.4.1",
  "description": "React binding for @clerkenwell/client: external stores, edit overlays, text bindings, autosync and the authoring runtime provider.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "@clerkenwell/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --conditions=@clerkenwell/source --import tsx --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\""
  },
  "dependencies": {
    "@clerkenwell/client": "0.4.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
