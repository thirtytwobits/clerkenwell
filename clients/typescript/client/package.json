{
  "name": "@clerkenwell/client",
  "version": "0.2.0",
  "description": "React-free client for Clerkenwell documents: plan types, projection materialisation and subscription, the authoring state machine, and a plan-driven Loro replica.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "@clerkenwell/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./replica": {
      "@clerkenwell/source": "./src/replica.ts",
      "types": "./dist/replica.d.ts",
      "default": "./dist/replica.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --conditions=@clerkenwell/source --import tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "loro-crdt": "https://github.com/thirtytwobits/loro/releases/download/loro-crdt-1.16.1-ef1964a3/loro-crdt-1.16.1.tgz"
  }
}
